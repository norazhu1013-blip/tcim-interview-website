# 是否使用模拟模型。true：不请求真实模型，便于程序联调；false：请求OpenAI兼容接口。
MOCK_MODEL=true

# OpenAI兼容模型配置。DeepSeek示例：
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=sk-xxxx
MODEL_NAME=deepseek-v4-flash
MODEL_TEMPERATURE=0.3
MODEL_TIMEOUT_SEC=60

# 资源路径。
KNOWLEDGE_DIR=./knowledge_base
MATERIALS_DIR=./outputs/advisor_run
SESSION_DIR=./outputs/sessions

# 单题访谈控制。
MAX_ITEM_MINUTES=10
MIN_ITEM_MINUTES=8
MAX_TURNS_PER_ITEM=10
