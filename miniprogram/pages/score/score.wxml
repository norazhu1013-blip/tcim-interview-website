<view class="bd bd-pad-btn">
  <!-- 总分 -->
  <view class="card" style="text-align:center;">
    <view class="muted">测评总分</view>
    <view class="big">{{scores.total}}<text class="big-max"> / {{scores.max}}</text></view>
    <view class="t">总体水平：{{scores.level}}</view>
  </view>

  <!-- 各题得分 -->
  <view class="card">
    <view class="h" style="font-size:28rpx;margin-bottom:8rpx;">各题得分</view>
    <view wx:for="{{rows}}" wx:key="id" class="li">
      <text class="t">{{item.id}} {{item.title}}</text>
      <text class="b-score">{{item.score}} / 4</text>
    </view>
  </view>

  <view class="muted" style="margin-top:16rpx;text-align:center;">依固定赋分表自动计算，无标准答案泄露</view>

  <!-- 访谈情境挑选（合并自 select 页） -->
  <block wx:if="{{hasSelection}}">
    <view class="sect" style="margin-top:36rpx;">为你挑选的 {{finalCount}} 个访谈情境</view>
    <view class="card">
      <view wx:for="{{finals}}" wx:key="id" class="opt" style="align-items:flex-start;">
        <view class="b">{{index + 1}}</view>
        <view class="x">
          <view>{{item.id}} {{item.title}}</view>
          <view class="muted" style="margin-top:4rpx;">{{item.secName}} · {{item.sourceText}}{{item.tagText}}</view>
        </view>
      </view>
      <view class="muted" style="margin-top:8rpx;">✦ 覆盖主二级指标：{{coverText}}</view>
    </view>

    <view class="sect">选择依据</view>
    <view class="card">
      <view class="muted" style="margin-bottom:12rpx;">从 {{examCount}} 题中依 R/P/G 三路合并去重 · 覆盖校验（主二级指标尽量分散），最终 {{finalCount}} 题为最值得深入交流的情境（非最低分题）。</view>
      <view class="li"><text class="t">R 分 · 结果偏离大</text><text class="muted">{{routeR}}</text></view>
      <view class="li"><text class="t">P 分 · 过程异常</text><text class="muted">{{routeP}}</text></view>
      <view class="li"><text class="t">G 分 · 结果×过程</text><text class="muted">{{routeG}}</text></view>
    </view>
  </block>
</view>

<view wx:if="{{hasSelection}}" class="foot">
  <button class="btn" bindtap="onGo">去 AI 访谈</button>
</view>
