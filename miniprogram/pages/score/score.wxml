<view class="bd">
  <view class="card" style="text-align:center;">
    <view class="muted">测评总分</view>
    <view class="big">{{scores.total}}<text class="big-max"> / {{scores.max}}</text></view>
    <view class="t">总体水平：{{scores.level}}</view>
  </view>

  <view class="card">
    <view class="h" style="font-size:28rpx;margin-bottom:8rpx;">各题得分</view>
    <view wx:for="{{rows}}" wx:key="id" class="li">
      <text class="t">{{item.id}} {{item.title}}</text>
      <text class="b-score">{{item.score}} / 4</text>
    </view>
  </view>

  <view class="muted" style="margin-top:24rpx;text-align:center;">依固定赋分表自动计算，无标准答案泄露</view>

  <button class="btn o" style="margin-top:28rpx;" bindtap="onSelect">去挑选访谈情境</button>
</view>
