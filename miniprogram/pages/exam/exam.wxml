<!-- 自绘导航栏：无系统返回键，退出走此处「退出」 -->
<view class="navbar" style="height:{{navBarH}}px;padding-top:{{statusBarHeight}}px;">
  <view class="nav-content" style="height:{{navContentH}}px;">
    <view class="nav-title">情境测评</view>
  </view>
</view>

<view class="exam-top" style="top:{{navBarH}}px;">
  <view class="row">
    <text class="muted">第 {{idx + 1}} / {{total}} 题</text>
    <text class="timer {{timeLow ? 'low' : ''}}" style="margin-left:auto;">剩余 {{countdown}}</text>
  </view>
  <view class="bar" style="margin-top:12rpx;"><i style="width:{{progress}}%;"></i></view>
</view>

<scroll-view scroll-y="{{!isDragging}}" class="exam-body {{isDragging ? 'no-scroll' : ''}}" style="top:{{bodyTop}}px;">
  <view class="card">
    <view class="muted" style="color:var(--pri);font-weight:600;">情境 · {{q.title}}</view>
    <image class="scenario-img" src="/images/scenarios/{{q.item_id}}.jpg" mode="widthFix" lazy-load="{{true}}" />
    <view class="t ink" style="margin-top:10rpx;">{{q.stem}}</view>
  </view>

  <view class="sorting-list" style="margin-top:20rpx;">
    <view wx:for="{{order}}" wx:key="*this"
          class="opt {{draggingIndex === index ? 'dragging' : ''}} {{dragOverIndex === index ? 'drag-over' : ''}}"
          data-index="{{index}}"
          bindtouchstart="onTouchStart"
          bindlongpress="onDragStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtouchcancel="onTouchEnd">
      <view class="b">{{item}}</view>
      <view class="x">{{q.options[item]}}</view>
      <view class="handle"><text class="handle-ic">⋮⋮</text></view>
    </view>
  </view>
</scroll-view>

<view class="foot row" style="gap:20rpx;">
  <button class="btn g sm" style="flex:0 0 150rpx;" bindtap="onPrev" disabled="{{idx === 0}}">上一题</button>
  <button class="btn sm" style="flex:1;" bindtap="onNext">{{idx === total - 1 ? '提交' : '下一题'}}</button>
</view>
