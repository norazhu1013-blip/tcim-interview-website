/* 自绘导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.nav-exit {
  position: absolute;
  left: 24rpx;
  font-size: 28rpx;
  color: var(--ink2);
  padding: 6rpx 8rpx;
}
.exam-top {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  background: #fff;
  padding: 14rpx 32rpx 12rpx;
  border-bottom: 1rpx solid var(--line);
}
.timer {
  font-size: 30rpx;
  color: var(--ink2);
}
.timer.low {
  color: #e0483c;
  font-weight: 600;
}
.exam-body {
  position: fixed;
  left: 0;
  right: 0;
  top: 96rpx;
  /* iOS 底部 Home Bar 高度算进来，避免选项被 foot 遮挡 */
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  padding: 20rpx 24rpx 40rpx;
}
/* 隐藏 scroll-view 滚动条（含内部滚动容器） */
.exam-body ::-webkit-scrollbar,
.exam-body::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
  background: transparent;
  color: transparent;
}
/* 拖拽期间禁止滚动条与惯性滚动，避免 pageY 抖动干扰位次换算 */
.exam-body.no-scroll {
  overflow: hidden;
  touch-action: none;
}
.sorting-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* 拖拽排序 */
.sorting-list {
  position: relative;
}
/* 答题页选项卡：紧凑上下间距 */
.sorting-list .opt {
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
  transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease, opacity 0.18s ease;
}
/* 拖拽手柄 */
.handle {
  margin-left: auto;
  width: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.handle-ic {
  font-size: 34rpx;
  color: #c3c8d2;
  line-height: 1;
  letter-spacing: -6rpx;
}
/* 被拖起的项：浮起 + 主色描边 + 阴影 */
.opt.dragging {
  opacity: 0.92;
  border-color: var(--pri);
  box-shadow: 0 10rpx 26rpx rgba(63, 99, 214, 0.22);
  transform: scale(1.02);
  z-index: 10;
}
/* 拖拽经过的落点占位 */
.opt.drag-over {
  border-color: var(--pri);
  background: #eef2fd;
}
/* 情境配图:仅答题页展示,题干上方,与整卡视觉对齐 */
.scenario-img {
  display: block;
  width: 100%;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: var(--soft);
}
