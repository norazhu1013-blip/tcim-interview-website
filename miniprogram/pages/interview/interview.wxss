/* 自绘导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.nav-exit {
  position: absolute;
  left: 24rpx;
  font-size: 28rpx;
  color: var(--ink2);
  padding: 6rpx 8rpx;
}
.iv-top {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
/* 访谈内“你的排序”选项：缩小字体 + 收紧内外边距，凸显对话 */
.iv-rank {
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
}
.iv-rank .b {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 22rpx;
  flex: 0 0 auto;
}
.iv-rank .x {
  font-size: 23rpx;
  line-height: 1.4;
}
.timer { font-size: 25rpx; color: var(--ink2); }
.timer.low { color: #e0483c; font-weight: 600; }

.iv-body {
  position: fixed;
  left: 0; right: 0;
  top: 90rpx;
  bottom: 130rpx;
  padding: 32rpx;
}

.msg { display: flex; gap: 16rpx; margin: 20rpx 0 40rpx; }
.msg .av {
  width: 52rpx; height: 52rpx; border-radius: 14rpx;
  background: var(--pri); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; flex: 0 0 auto;
}
.msg .bub {
  background: #fff; border: 1rpx solid var(--line);
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  padding: 18rpx 22rpx; font-size: 28rpx; line-height: 1.55;
  max-width: 480rpx;
}
.msg.me { flex-direction: row-reverse; }
.msg.me .av { background: #c8cdd8; }
.msg.me .bub {
  background: var(--pri); color: #fff; border: none;
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.iv-foot {
  display: flex; align-items: flex-end; gap: 14rpx;
}
.iv-input {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  min-height: 40rpx;
  max-height: 200rpx;
  background: #fff;
}
.send { flex: 0 0 120rpx; }
.fs-fab {
  position: fixed;
  left: 24rpx;
  z-index: 101;
  min-width: 72rpx;
  padding: 10rpx 18rpx;
  background: rgba(255,255,255,0.95);
  border: 1rpx solid var(--line);
  border-radius: 40rpx;
  font-size: 24rpx;
  color: var(--ink2);
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.rv-time { text-align: center; margin-top: 12rpx; }
