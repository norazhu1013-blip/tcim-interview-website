.iv-top {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.timer { font-size: 25rpx; color: var(--ink2); }
.timer.low { color: #e0483c; font-weight: 600; }

.iv-body {
  position: fixed;
  left: 0; right: 0;
  top: 90rpx;
  bottom: 130rpx;
  padding: 32rpx;
}

.msg { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.msg .av {
  width: 52rpx; height: 52rpx; border-radius: 14rpx;
  background: var(--pri); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; flex: 0 0 auto;
}
.msg .bub {
  background: #fff; border: 1rpx solid var(--line);
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  padding: 18rpx 22rpx; font-size: 26rpx; line-height: 1.55;
  max-width: 480rpx;
}
.msg.me { flex-direction: row-reverse; }
.msg.me .av { background: #c8cdd8; }
.msg.me .bub {
  background: var(--pri); color: #fff; border: none;
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.iv-foot {
  display: flex; align-items: flex-end; gap: 14rpx;
}
.iv-input {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  min-height: 40rpx;
  max-height: 200rpx;
  background: #fff;
}
.send { flex: 0 0 120rpx; }
.rv-time { text-align: center; margin-top: 12rpx; }
