/* 自绘导航栏 */
.navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid var(--line);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.nav-title {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}
.nav-exit {
  font-size: 28rpx;
  color: var(--ink2);
  padding: 6rpx 8rpx;
}
/* 顶部左侧工具条：返回 + 缩放按钮并排显示，标题绝对居中不受影响 */
.nav-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.iv-top {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
/* 缩放按钮：仿微信胶囊样式，连体圆角+中间分隔线，尺寸由 JS 读取原生胶囊动态传入 */
.zoom-ctrl {
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(0,0,0,0.08);
  background: rgba(255,255,255,0.9);
  overflow: hidden;
  box-sizing: border-box;
}
.zbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  line-height: 1;
  color: #000;
  box-sizing: border-box;
  white-space: nowrap;
}
.zbtn + .zbtn {
  border-left: 1rpx solid rgba(0,0,0,0.08);
}
.zbtn:active { background: rgba(0,0,0,0.06); }
/* 访谈内“你的排序”选项：缩小字体 + 收紧内外边距，凸显对话 */
.iv-rank {
  padding: 10rpx 14rpx;
  margin-bottom: 8rpx;
}
.iv-rank .b {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  font-size: 22rpx;
  flex: 0 0 auto;
}
.iv-rank .x {
  font-size: 23rpx;
  line-height: 1.4;
}
.timer { font-size: 25rpx; color: var(--ink2); }
.timer.low { color: #e0483c; font-weight: 600; }

.iv-body {
  position: fixed;
  left: 0; right: 0;
  top: 90rpx;
  bottom: 130rpx;
  padding: 32rpx 8rpx 32rpx 32rpx;
}

.msg { display: flex; gap: 16rpx; margin: 20rpx 0 40rpx; }
.msg .av {
  width: 52rpx; height: 52rpx; border-radius: 14rpx;
  background: var(--pri); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; flex: 0 0 auto;
}
.msg .bub {
  background: #fff; border: 1rpx solid var(--line);
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  padding: 18rpx 22rpx; font-size: 28rpx; line-height: 1.55;
  max-width: 600rpx;
}
.msg.me { flex-direction: row-reverse; }
.msg.me .av { background: #c8cdd8; }
.msg.me .bub {
  background: var(--pri); color: #fff; border: none;
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.iv-foot {
  display: block;
}
.iv-compose {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
}
.iv-input {
  flex: 1;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 25rpx;
  min-height: 40rpx;
  max-height: 200rpx;
  background: #fff;
}
.send { flex: 0 0 120rpx; }
.rv-time { text-align: center; margin-top: 12rpx; }
.ai-disclaimer {
  margin-top: 12rpx;
  color: var(--ink3);
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
}
.iv-done-foot .ai-disclaimer { margin-top: 12rpx; }
