<!-- 自绘导航栏：无系统返回键，退出走此处「退出」 -->
<view class="navbar" style="height:{{navBarH}}px;padding-top:{{statusBarHeight}}px;">
  <view class="nav-content" style="height:{{navContentH}}px;">
    <view wx:if="{{isReview}}" class="nav-exit" bindtap="onExit">返回</view>
    <view class="nav-title">AI 访谈</view>
  </view>
</view>

<view class="iv-top" style="top:{{navBarH}}px;">
  <text class="h" style="font-size:27rpx;">{{q.title}}</text>
  <text wx:if="{{!isReview}}" class="timer {{timeLow ? 'low' : ''}}" style="margin-left:auto;">{{countdown}}</text>
  <text wx:else class="muted" style="margin-left:auto;">回看</text>
</view>

<scroll-view scroll-y class="iv-body" style="top:{{bodyTop}}px;" scroll-into-view="{{scrollTo}}" scroll-with-animation>
  <!-- 案例卡：完整案例 + 四选项 + 本人排序 -->
  <view class="card" id="case">
    <view class="muted" style="color:var(--pri);font-weight:600;">情境 · {{q.title}}</view>
    <view class="t ink" style="margin-top:8rpx;">{{q.stem}}</view>
    <view class="muted" style="margin:12rpx 0 6rpx;">你的排序（最理想 → 最不理想）</view>
    <view wx:for="{{rankRows}}" wx:key="opt" class="opt iv-rank">
      <view class="b">{{item.opt}}</view>
      <view class="x">{{item.text}}</view>
    </view>
  </view>

  <!-- 对话 -->
  <view wx:for="{{messages}}" wx:key="idx" id="m{{index}}" class="msg {{item.role === 'me' ? 'me' : ''}}">
    <view class="av">{{item.role === 'me' ? '师' : 'AI'}}</view>
    <view class="bub">{{item.text}}</view>
  </view>

  <view wx:if="{{thinking}}" class="msg">
    <view class="av">AI</view>
    <view class="bub muted">正在思考追问…</view>
  </view>

  <view wx:if="{{isReview && submittedText}}" class="muted rv-time">提交时间：{{submittedText}}</view>
  <view id="bottom" style="height:20rpx;"></view>
</scroll-view>

<!-- 输入区（回看模式隐藏） -->
<view wx:if="{{!isReview && !done}}" class="foot iv-foot">
  <textarea class="iv-input" placeholder="说说你的想法…" value="{{input}}" bindinput="onInput"
    auto-height maxlength="500" disabled="{{sending}}"
    show-confirm-bar="{{false}}" adjust-position="{{true}}" cursor-spacing="20"
    hold-keyboard="{{true}}"></textarea>
  <button class="btn sm send" bindtap="onSend" disabled="{{sending || !input}}">发送</button>
</view>

<view wx:if="{{!isReview && done}}" class="foot">
  <button class="btn" bindtap="onBack">完成，返回情境列表</button>
</view>
