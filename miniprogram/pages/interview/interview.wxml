<!-- 自绘导航栏：无系统返回键，退出走此处「退出」 -->
<view class="navbar" style="height:{{navBarH}}px;padding-top:{{statusBarHeight}}px;">
  <view class="nav-content" style="height:{{navContentH}}px;">
  <view class="nav-left">
    <view wx:if="{{isReview}}" class="nav-exit" bindtap="onExit">返回</view>
    <view class="zoom-ctrl" style="height:{{capH}}px;border-radius:{{capR}}px;">
      <view class="zbtn" style="width:{{capW}}px;height:{{capH}}px;" bindtap="onZoomOut">🔍−</view>
      <view class="zbtn" style="width:{{capW}}px;height:{{capH}}px;" bindtap="onZoomIn">🔍+</view>
    </view>
  </view>
  <view class="nav-title">AI 访谈</view>
</view>
</view>

<view class="iv-top" style="top:{{navBarH}}px;">
  <text class="h" style="font-size:{{topTitleSize}}rpx;">{{q.title}}</text>
  <text wx:if="{{!isReview}}" class="timer {{timeLow ? 'low' : ''}}" style="margin-left:auto;">{{countdown}}</text>
  <text wx:else class="muted" style="margin-left:auto;">回看</text>
</view>

<scroll-view scroll-y class="iv-body" style="top:{{bodyTop}}px;bottom:calc(180rpx + {{kbHeight}}px);" scroll-into-view="{{scrollTo}}" scroll-with-animation bindtouchstart="onBodyTouchStart" bindtouchmove="onBodyTouchMove" bindtouchend="onBodyTouchEnd" bindtouchcancel="onBodyTouchEnd">
  <!-- 案例卡：完整案例 + 四选项 + 本人排序 -->
  <view class="card" id="case">
    <view class="muted" style="color:var(--pri);font-weight:600;">情境 · {{q.title}}</view>
    <view class="t ink" style="margin-top:8rpx;font-size:{{stemSize}}rpx;">{{q.stem}}</view>
    <view class="muted" style="margin:12rpx 0 6rpx;">你的排序（最理想 → 最不理想）</view>
    <view wx:for="{{rankRows}}" wx:key="opt" class="opt iv-rank">
      <view class="b" style="font-size:{{rankBSize}}rpx;">{{item.opt}}</view>
      <view class="x" style="font-size:{{rankXSize}}rpx;">{{item.text}}</view>
    </view>
  </view>

  <!-- 对话 -->
  <view wx:for="{{messages}}" wx:key="idx" id="m{{index}}" class="msg {{item.role === 'me' ? 'me' : ''}}">
    <view class="av">{{item.role === 'me' ? '我' : 'AI'}}</view>
    <view class="bub" style="font-size:{{bubSize}}rpx;">{{item.text}}<view class="mt muted">{{item.timeText}}</view></view>
  </view>

  <view wx:if="{{thinking}}" class="msg">
    <view class="av">AI</view>
    <view class="bub muted">正在整理下一问…</view>
  </view>

  <view wx:if="{{isReview && submittedText}}" class="muted rv-time">提交时间：{{submittedText}}</view>
  <view wx:if="{{isReview}}" class="ai-disclaimer">内容由AI生成，仅供参考</view>
  <view id="bottom" style="height:20rpx;"></view>
</scroll-view>

<!-- 输入区（回看模式隐藏） -->
<view wx:if="{{!isReview && !done}}" class="foot iv-foot" style="bottom:{{kbHeight}}px;">
  <view class="iv-compose">
    <textarea class="iv-input" style="font-size:{{inputSize}}rpx;" placeholder="请输入您的回答…" value="{{input}}"
      bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur"
      bindkeyboardheightchange="onKbHeightChange"
      auto-height maxlength="500" disabled="{{sending}}"
      show-confirm-bar="{{false}}" adjust-position="{{false}}" cursor-spacing="8"
      fixed="{{true}}" hold-keyboard="{{true}}"></textarea>
    <button class="btn sm send" bindtap="onSend" disabled="{{sending || !input}}">发送</button>
  </view>
  <view class="ai-disclaimer">内容由AI生成，仅供参考</view>
</view>

<view wx:if="{{!isReview && done}}" class="foot iv-done-foot">
  <view class="done-title">本情境访谈已完成</view>
  <button class="btn" bindtap="onBack">返回情境列表</button>
  <view class="ai-disclaimer">内容由AI生成，仅供参考</view>
</view>
