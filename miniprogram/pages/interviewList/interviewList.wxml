<view class="bd">
  <view class="t">AI 将就以下 {{list.length}} 个情境和你聊聊，每个不超过 10 分钟，没有标准答案。内容由AI生成，仅供参考。</view>

  <view wx:for="{{list}}" wx:key="id" class="card interview-card" style="margin-top:{{index === 0 ? 24 : 0}}rpx;">
    <view class="row">
      <text class="h" style="font-size:28rpx;">{{item.no}} {{item.title}}</text>
      <text class="pill {{item.done ? 'on' : ''}}" style="margin-left:auto;">{{item.done ? '已完成' : '待访谈'}}</text>
    </view>
    <view class="muted" style="margin-top:12rpx;">{{item.focus}}</view>
    <button class="btn {{item.done ? 'g' : ''}} sm" style="margin-top:18rpx;" data-id="{{item.id}}" data-done="{{item.done}}" bindtap="onOpen">
      {{item.done ? '回看访谈' : '开始访谈'}}
    </button>
  </view>

  <view wx:if="{{allDone}}" class="card" style="text-align:center;">
    <view class="h" style="font-size:28rpx;">{{feedbackDone ? '访谈完成，感谢！' : '3 个情境都聊完啦'}}</view>
    <view class="t" style="margin-top:10rpx;">{{feedbackDone ? '可随时回看访谈内容。' : '最后请留下你对本次 AI 访谈的反馈。'}}</view>
    <button wx:if="{{!feedbackDone}}" class="btn" style="margin-top:18rpx;" bindtap="onFeedback">填写访谈反馈</button>
    <button wx:else class="btn o" style="margin-top:18rpx;" bindtap="onHome">回到首页</button>
  </view>
</view>
