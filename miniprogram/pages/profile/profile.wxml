<view class="bd">
  <view class="card form-card">
    <view class="li">
      <text class="t">姓名<text class="req">*</text></text>
      <input class="fld" placeholder="请输入" value="{{form.name}}" data-k="name" bindinput="onInput" />
    </view>
    <view class="li">
      <text class="t">园所<text class="req">*</text></text>
      <input class="fld" placeholder="请输入园所名称" value="{{form.kindergarten}}" data-k="kindergarten" bindinput="onInput" />
    </view>
    <picker class="picker" mode="selector" range="{{teachAges}}" value="{{teachAgeIdx}}" bindchange="onTeachAge">
      <view class="li picker-row">
        <text class="t">教龄<text class="req">*</text></text>
        <view class="pick-val {{form.teachAge ? '' : 'placeholder'}}">
          <text class="pick-text">{{form.teachAge || '请选择'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>
  </view>
  <!-- 保存按钮：紧跟个人信息模块 -->
  <button class="btn save-inline" bindtap="onSave">{{isFirst ? '保存并开始答题' : '保存修改'}}</button>

  <!-- 管理员:数据导出(仅管理员可见;账号/OpenID/试卷码/任教班级已移除) -->
  <block wx:if="{{isAdmin}}">
    <view class="sect">管理员</view>
    <view class="card form-card">
      <view class="li" bindtap="onExportExcel" hover-class="li-hover">
        <text class="t">导出整理版 Excel</text>
        <text class="fld muted">分工作表整理 · 保留姓名 ›</text>
      </view>
      <view class="li" bindtap="onExportJson" hover-class="li-hover">
        <text class="t">导出原始 JSON</text>
        <text class="fld muted">完整备份 · 保留全部字段 ›</text>
      </view>
    </view>
  </block>
</view>
