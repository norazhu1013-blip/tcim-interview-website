# 网页 HTTPS 网关地址，例如 https://gsyg.age08.cn/gsyg-web。
# 网页只调用此网关，不直接调用依赖 wxContext.OPENID 的小程序云函数。
VITE_WEB_API_BASE_URL=https://gsyg.age08.cn/gsyg-web

# CloudBase 匿名登录所用环境。此环境 ID 可公开；管理员密钥、AppSecret、
# LLM API Key、网关密钥均不得放到前端。
VITE_CLOUDBASE_ENV_ID=cloud1-2gefzeri3cb333f2
VITE_CLOUDBASE_REGION=ap-shanghai

# TCIM 访谈模式：
#   ont    = TCIM 确定性访谈（默认，本地引擎，不依赖 LLM）
#   legacy = 旧 LLM 提示词访谈（走 gsyg_interviewChat）
VITE_TCIM_MODE=ont

# RAG 按需知识（默认关闭）。设为 1 开启；仍只在 Orchestrator 判定
# knowledge_need=true 时触发（当前需核心槽缺口大且谈了几轮无进展）。
VITE_TCIM_RAG=

# 可选：legacy 模式下选择云函数预配置的模型组（wxai / deepseek / openai-compatible）。
# 仅 TCIM legacy 模式使用；ont 模式不调用任何 LLM。
VITE_INTERVIEW_LLM_PROFILE=
