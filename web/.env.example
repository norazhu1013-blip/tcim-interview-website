# 网页 HTTPS 网关地址，例如 https://api.example.com/gsyg-web。
# 网页只调用此网关，不直接调用依赖 wxContext.OPENID 的小程序云函数。
VITE_WEB_API_BASE_URL=

# CloudBase 身份认证 v2：微信开放平台网站扫码登录。
# 此环境 ID 可公开；管理员密钥、AppSecret、网关密钥均不得放到前端。
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai

# 仅当管理员同时开启 CloudBase 匿名登录并希望自动完成首次扫码帐号绑定时设为 true。
VITE_CLOUDBASE_ENABLE_FIRST_LOGIN_BIND=false
