# 网页 HTTPS 网关地址，例如 https://api.example.com/gsyg-web。
# 网页只调用此网关，不直接调用依赖 wxContext.OPENID 的小程序云函数。
VITE_WEB_API_BASE_URL=

# CloudBase 匿名登录所用环境。此环境 ID 可公开；管理员密钥、AppSecret、
# LLM API Key、网关密钥均不得放到前端。
VITE_CLOUDBASE_ENV_ID=
VITE_CLOUDBASE_REGION=ap-shanghai

# 可选：选择云函数中预先配置好的模型组；留空时由云函数默认配置决定。
# 可填 wxai、deepseek 或 openai-compatible。这里不能填写 endpoint 或 API Key。
VITE_INTERVIEW_LLM_PROFILE=
