# Leave TCIM_DIALOGUE_PROVIDER unset to auto-select Kimi first, then OpenAI.
# Explicit values: kimi | openai | mock
TCIM_DIALOGUE_PROVIDER=
TCIM_DIALOGUE_HOST=127.0.0.1
TCIM_DIALOGUE_PORT=8787
TCIM_DIALOGUE_TIMEOUT_MS=45000
TCIM_DIALOGUE_MAX_BODY_BYTES=1048576
TCIM_DIALOGUE_MAX_HISTORY_TURNS=40
TCIM_LOCAL_DATA_FILE=./.runtime-data/state.json
# 仅限注入 mock fetch 或本机兼容服务测试；正常使用必须保持 0
TCIM_DIALOGUE_ALLOW_UNSAFE_PROVIDER_URLS=0

# Kimi K3 (OpenAI-compatible Chat Completions)
KIMI_API_KEY=
# 与第一版腾讯云函数保持兼容；KIMI_API_KEY 为空时可改填这一项。
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
KIMI_MAX_COMPLETION_TOKENS=4000

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high
OPENAI_MAX_OUTPUT_TOKENS=4000
