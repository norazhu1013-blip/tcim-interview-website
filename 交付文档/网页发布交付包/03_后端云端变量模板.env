# 仅在腾讯云后台的环境变量/密钥管理中填写。
# 不要把填好后的文件放入Git、网页构建目录、微信或日志。

TCIM_DIALOGUE_PROVIDER=kimi
KIMI_API_KEY=<在腾讯云密钥管理中填写>
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3

# 若改用OpenAI，按发布实验方案设置下列变量，并保持会话内模型锁。
OPENAI_API_KEY=<在腾讯云密钥管理中填写>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=<经Fixture验证通过的模型快照或受控别名>

TCIM_DIALOGUE_TIMEOUT_MS=45000
TCIM_DIALOGUE_MAX_BODY_BYTES=1048576
TCIM_DIALOGUE_MAX_HISTORY_TURNS=8
TCIM_DIALOGUE_FAST_REASONING_EFFORT=low
TCIM_DIALOGUE_FAST_MAX_OUTPUT_TOKENS=500
TCIM_EVIDENCE_REASONING_EFFORT=medium
TCIM_EVIDENCE_MAX_OUTPUT_TOKENS=1600

WEB_ALLOWED_ORIGIN=https://<正式网页精确域名>

# 沿用正式环境已有的会话、网关令牌和CloudBase连接变量。
# 禁止设置：TCIM_DIALOGUE_ALLOW_UNSAFE_PROVIDER_URLS=1
